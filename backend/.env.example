# Sentinelas backend — environment variable reference
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────

# ── n8n webhook ───────────────────────────────────────────────────────────────
# Active workflow (production listener) — n8n_main container on host port 4555.
# The path MUST match the webhook node's "path" property: sentinelas-anomaly
N8N_WEBHOOK_URL=http://localhost:4555/webhook/sentinelas-anomaly
#
# Use the webhook-test path only when clicking "Execute workflow" manually in n8n:
# N8N_WEBHOOK_URL=http://localhost:4555/webhook-test/sentinelas-anomaly

# ── Telemetry ─────────────────────────────────────────────────────────────────
# PROMETHEUS_URL=http://prometheus-k8s.monitoring.svc.cluster.local:9090
# LOKI_URL=http://loki-gateway.monitoring.svc.cluster.local:3100
# TEMPO_URL=http://tempo.monitoring.svc.cluster.local:3200

# ── Caching / Database ────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# POSTGRES_URL=postgresql://aiops:aiops_password@localhost:5432/aiops_ground_truth

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_SECONDS=180
